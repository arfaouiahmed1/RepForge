# RepForge backend — environment template
# Copy to .env (gitignored) and fill with REAL values. Never commit real secrets.

# --- Supabase (Postgres + storage) -------------------------------------------
# Project Settings → API in the Supabase dashboard
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# service_role key — server-side ONLY, bypasses RLS. Never ship to clients/APK.
SUPABASE_SERVICE_KEY=your-service-role-key-here
# Direct Postgres connection string for migrations (Settings → Database)
SUPABASE_DB_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# --- Firebase (Auth ID token verification) -----------------------------------
# When unset, the backend runs FAIL-CLOSED: every /v1/* route returns 401.
FIREBASE_PROJECT_ID=your-firebase-project-id
# Service-account JSON path (optional — only needed to mint tokens/call Play API;
# plain verifyIdToken works with just FIREBASE_PROJECT_ID).
# Either of these two:
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON_PATH=/absolute/path/service-account.json

# --- Google Play Developer API (billing verification, task 34) ---------------
PLAY_DEVELOPER_ACCOUNT_ID=
RTDN_PUSH_TOKEN=

# --- Server ------------------------------------------------------------------
PORT=8080
